{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nemotron": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nemotron on Modal",
      "options": {
        "baseURL": "{env:CODER_URL}/v1",
        "apiKey": "{env:NEMOTRON_API_KEY}"
      },
      "models": {
        "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4": {
          "name": "Nemotron 3 Super (Modal)",
          "limit": { "context": 262144, "output": 32768 }
        },
        "nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-NVFP4": {
          "name": "Nemotron 3 Ultra (Modal)",
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    },
    "nvidia-build": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "build.nvidia.com (free tier)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "nvidia/nemotron-3.5-super-vl-120b-a12b": { "name": "Nemotron 3.5 Super-VL (NVIDIA API)" },
        "nvidia/nemotron-3.5-lightning-30b-a3b": { "name": "Nemotron 3.5 Lightning (NVIDIA API)" },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra (NVIDIA API, slow queue)" }
      }
    }
  },
  "model": "nemotron/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "nvidia-cuda-docs": {
      "type": "remote",
      "url": "https://api.copilot.nsight.ngc.nvidia.com/mcp/cuda-docs",
      "enabled": true
    },
    "nvidia-dynamo-docs": {
      "type": "remote",
      "url": "https://docs.nvidia.com/dynamo/_mcp/server",
      "enabled": true
    },
    "nvidia-aiperf-docs": {
      "type": "remote",
      "url": "https://docs.nvidia.com/aiperf/_mcp/server",
      "enabled": true
    },
    "nvidia-guardrails-docs": {
      "type": "remote",
      "url": "https://docs.nvidia.com/nemo/guardrails/_mcp/server",
      "enabled": true
    },
    "nvidia-brev-docs": {
      "type": "remote",
      "url": "https://docs.nvidia.com/brev/_mcp/server",
      "enabled": false
    }
  }
}
