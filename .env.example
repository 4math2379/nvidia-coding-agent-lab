# Free NVIDIA API key (build.nvidia.com): used by Zed, OpenCode and client.py
NVIDIA_API_KEY=nvapi-your-key

# Key of your Modal endpoint (same value as the nemotron-api-key Modal secret)
NEMOTRON_API_KEY=your-endpoint-key

# URL printed by `modal deploy coder/serve.py`, without /v1
CODER_URL=https://your-workspace--nemotron-coder-super-rtx-server.us-west.modal.direct
